{
  "version": 8,
  "name": "Wanzila Brazzaville",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a> · <a href=\"https://openfreemap.org\">OpenFreeMap</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f9faff" }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": { "fill-color": "#dff4e5", "fill-opacity": 0.9 }
    },
    {
      "id": "woodland",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "wood"],
      "paint": { "fill-color": "#e5f5e9", "fill-opacity": 0.8 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#b7d9ff" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": { "line-color": "#bddfff", "line-width": 1.4 }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 12,
      "paint": { "fill-color": "#edf0f8", "fill-outline-color": "#e3e8f3" }
    },
    {
      "id": "minor-road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["minor", "service", "track", "path"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#dfe5f1",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1.5, 15, 7]
      }
    },
    {
      "id": "minor-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["minor", "service", "track", "path"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1, 15, 5]
      }
    },
    {
      "id": "major-road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["primary", "secondary", "tertiary", "trunk", "motorway"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#e8d5a9",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 2, 15, 12]
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["primary", "secondary", "tertiary", "trunk", "motorway"]]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#fff8e9",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1.3, 15, 9]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 15, 12],
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#657392",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "neighborhood-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 10,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["suburb", "neighbourhood", "quarter"]]
      ],
      "layout": {
        "text-field": [
          "upcase",
          ["coalesce", ["get", "name:latin"], ["get", "name"]]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-letter-spacing": 0.16,
        "text-size": 12
      },
      "paint": {
        "text-color": "#58668b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "city-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 7,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 15, 13, 23]
      },
      "paint": {
        "text-color": "#243258",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 9,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 13
      },
      "paint": {
        "text-color": "#4c81c1",
        "text-halo-color": "#d5e8ff",
        "text-halo-width": 1
      }
    }
  ]
}
