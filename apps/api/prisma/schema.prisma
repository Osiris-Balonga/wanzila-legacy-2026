generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

generator bootstrap_client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DutyExceptionKind {
  CANCELLED
  UNAVAILABLE
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum RouteAttemptOutcome {
  UNKNOWN
  GPS_CONFIRMED
  USER_DECLARED
  STOPPED
  ALREADY_NEARBY
}

model AdminUser {
  id                     String         @id @default(uuid()) @db.Char(36)
  email                  String         @unique @db.VarChar(320)
  passwordHash           String         @db.VarChar(255)
  displayName            String         @db.VarChar(120)
  createdAt              DateTime       @default(now()) @db.DateTime(3)
  updatedAt              DateTime       @updatedAt @db.DateTime(3)
  sessions               AdminSession[]
  submittedDutyRevisions DutyRevision[] @relation("DutyRevisionSubmitter")
  reviewedDutyRevisions  DutyRevision[] @relation("DutyRevisionReviewer")
  contributionCorrections ContributionCorrection[]
  reviewedContributions Contribution[] @relation("ContributionReviewer")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Char(36)
  adminUserId String    @db.Char(36)
  tokenDigest String    @unique @db.Char(64)
  expiresAt   DateTime  @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
}

model Pharmacy {
  id               String            @id @default(uuid()) @db.Char(36)
  name             String            @db.VarChar(180)
  phone            String?           @db.VarChar(32)
  address          String            @db.VarChar(255)
  district         String            @db.VarChar(120)
  arrondissement   String            @db.VarChar(120)
  latitude         Decimal           @db.Decimal(10, 7)
  longitude        Decimal           @db.Decimal(10, 7)
  recordSource     String?           @db.VarChar(255)
  recordVerifiedAt DateTime?         @db.DateTime(3)
  photoAssetPath   String?           @db.VarChar(255)
  photoSource      String?           @db.VarChar(255)
  photoCredit      String?           @db.VarChar(255)
  photoRights      String?           @db.VarChar(255)
  photoVerifiedAt  DateTime?         @db.DateTime(3)
  status           PublicationStatus @default(DRAFT)
  createdAt        DateTime          @default(now()) @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @db.DateTime(3)
  matchKey         String?           @unique @db.Char(64)
  duties           DutyPeriod[]
  contributions    Contribution[]
  reports          Report[]

  @@index([status, arrondissement, district])
  @@index([latitude, longitude])
}

model ScheduleSource {
  id          String       @id @default(uuid()) @db.Char(36)
  name        String       @db.VarChar(180)
  description String?      @db.Text
  reliability Int          @default(50) @db.UnsignedTinyInt
  observedAt  DateTime     @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @db.DateTime(3)
  duties      DutyPeriod[]
}

model DutyPeriod {
  id         String          @id @default(uuid()) @db.Char(36)
  pharmacyId String          @db.Char(36)
  sourceId   String?         @db.Char(36)
  startsAt   DateTime        @db.DateTime(3)
  endsAt     DateTime        @db.DateTime(3)
  status     ReviewStatus    @default(PENDING)
  version    Int             @default(0) @db.UnsignedInt
  createdAt  DateTime        @default(now()) @db.DateTime(3)
  updatedAt  DateTime        @updatedAt @db.DateTime(3)
  pharmacy   Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  source     ScheduleSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  exceptions DutyException[]
  revisions  DutyRevision[]

  @@index([startsAt, endsAt, status])
  @@index([pharmacyId, startsAt, endsAt])
}

model DutyRevision {
  id               String       @id @default(uuid()) @db.Char(36)
  dutyPeriodId     String       @db.Char(36)
  status           ReviewStatus @default(PENDING)
  openRevisionKey  String?      @db.Char(1)
  baseVersion      Int          @db.UnsignedInt
  beforeSourceId   String?      @db.Char(36)
  beforeStartsAt   DateTime     @db.DateTime(3)
  beforeEndsAt     DateTime     @db.DateTime(3)
  proposedSourceId String?      @db.Char(36)
  proposedStartsAt DateTime     @db.DateTime(3)
  proposedEndsAt   DateTime     @db.DateTime(3)
  submissionNote   String       @db.VarChar(500)
  submittedById    String       @db.Char(36)
  submittedByName  String       @db.VarChar(120)
  submittedAt      DateTime     @db.DateTime(3)
  reviewNote       String?      @db.VarChar(500)
  reviewedById     String?      @db.Char(36)
  reviewedByName   String?      @db.VarChar(120)
  reviewedAt       DateTime?    @db.DateTime(3)
  dutyPeriod       DutyPeriod   @relation(fields: [dutyPeriodId], references: [id], onDelete: Restrict)
  submittedBy      AdminUser    @relation("DutyRevisionSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy       AdminUser?   @relation("DutyRevisionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([dutyPeriodId, openRevisionKey])
  @@index([dutyPeriodId, submittedAt, id])
}

model DutyException {
  id           String            @id @default(uuid()) @db.Char(36)
  dutyPeriodId String            @db.Char(36)
  kind         DutyExceptionKind
  startsAt     DateTime          @db.DateTime(3)
  endsAt       DateTime          @db.DateTime(3)
  reason       String?           @db.VarChar(255)
  createdAt    DateTime          @default(now()) @db.DateTime(3)
  updatedAt    DateTime          @updatedAt @db.DateTime(3)
  dutyPeriod   DutyPeriod        @relation(fields: [dutyPeriodId], references: [id], onDelete: Cascade)

  @@index([dutyPeriodId, startsAt, endsAt])
}

model Contribution {
  id             String       @id @default(uuid()) @db.Char(36)
  pharmacyId     String?      @db.Char(36)
  pharmacyName   String       @db.VarChar(180)
  phone          String?      @db.VarChar(32)
  address        String       @db.VarChar(255)
  district       String       @db.VarChar(120)
  arrondissement String       @db.VarChar(120)
  latitude       Decimal?     @db.Decimal(10, 7)
  longitude      Decimal?     @db.Decimal(10, 7)
  note           String?      @db.Text
  submissionId   String?      @unique @db.Char(36)
  original       Json?
  version        Int          @default(0) @db.UnsignedInt
  reviewNote     String?      @db.VarChar(500)
  notePurgedAt   DateTime?    @db.DateTime(3)
  reviewedById   String?      @db.Char(36)
  reviewedByName String?      @db.VarChar(120)
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  reviewedAt     DateTime?    @db.DateTime(3)
  pharmacy       Pharmacy?    @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  reviewedBy     AdminUser?   @relation("ContributionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  corrections    ContributionCorrection[]

  @@index([status, createdAt])
}

model ContributionCorrection {
  id             String       @id @default(uuid()) @db.Char(36)
  contributionId String       @db.Char(36)
  version        Int          @db.UnsignedInt
  before         Json
  after          Json
  reason         String       @db.VarChar(500)
  correctedById  String       @db.Char(36)
  correctedByName String      @db.VarChar(120)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  contribution   Contribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  correctedBy    AdminUser    @relation(fields: [correctedById], references: [id], onDelete: Restrict)

  @@unique([contributionId, version])
}

model Report {
  id          String       @id @default(uuid()) @db.Char(36)
  pharmacyId  String       @db.Char(36)
  category    String       @db.VarChar(80)
  description String?      @db.Text
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now()) @db.DateTime(3)
  resolvedAt  DateTime?    @db.DateTime(3)
  pharmacy    Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model EmergencyContact {
  id        String            @id @default(uuid()) @db.Char(36)
  label     String            @db.VarChar(120)
  phone     String            @db.VarChar(32)
  position  Int               @default(0) @db.UnsignedInt
  status    PublicationStatus @default(DRAFT)
  updatedAt DateTime          @updatedAt @db.DateTime(3)

  @@index([status, position])
}

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Char(36)
  name       String   @db.VarChar(80)
  pharmacyId String?  @db.Char(36)
  sessionId  String?  @db.Char(36)
  properties Json?
  occurredAt DateTime @default(now()) @db.DateTime(3)

  @@index([name, occurredAt])
  @@index([pharmacyId, occurredAt])
}

model RouteAttempt {
  id         String              @id @db.Char(36)
  pharmacyId String              @db.Char(36)
  sessionId  String              @db.Char(36)
  outcome    RouteAttemptOutcome @default(UNKNOWN)
  startedAt  DateTime            @default(now()) @db.DateTime(3)
  resolvedAt DateTime?           @db.DateTime(3)

  @@index([startedAt, outcome])
  @@index([pharmacyId, startedAt])
}
