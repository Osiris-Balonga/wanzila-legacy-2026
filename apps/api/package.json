{
  "name": "@wanzila/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --maxWorkers 1 --no-file-parallelism test",
    "admin:bootstrap": "node src/modules/admin-auth/bootstrap.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:seed": "pnpm db:generate && tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@wanzila/contracts": "workspace:*",
    "@wanzila/domain": "workspace:*",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.4",
    "mariadb": "3.5.4",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
