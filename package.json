{
  "name": "wanzila",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.18 <25",
    "pnpm": ">=11.19 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @wanzila/api --filter @wanzila/web dev",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages tests playwright.config.ts vitest.config.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @wanzila/api db:generate",
    "db:migrate": "pnpm --filter @wanzila/api db:migrate",
    "db:seed": "pnpm --filter @wanzila/api db:seed",
    "db:reset": "pnpm --filter @wanzila/api db:reset",
    "validate": "pnpm db:generate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
